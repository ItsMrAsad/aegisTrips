# Shared secret — must match backend AGENT_API_KEY
AGENT_API_KEY=super-secret-shared-key-change-me

# Key used for HMAC-SHA256 TEE attestation proofs
TEE_SECRET_KEY=tee-attestation-secret-change-in-production

# Mock credentials — ONLY stored here, never in backend or frontend
# In a real Terminal 3 TEE deployment these would be hardware-sealed.
MOCK_CREDIT_CARD=4111111111111111
MOCK_PASSPORT=PA12345678

PORT=3001

# ── Terminal 3 ADK Integration ──────────────────────────────────────────────
# Your Terminal 3 developer private key (0x... format).
# This is the wallet identity given to you on the T3N claim page.
# Never commit this. Never share it.
T3N_PRIVATE_KEY=0xYourTerminal3PrivateKeyHere

# T3N network: "testnet" for hackathon, "production" for live
T3N_ENVIRONMENT=testnet
