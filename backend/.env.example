# Google AI Studio API key - get one at https://aistudio.google.com
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Shared secret authenticating this backend to the secure-worker
# Must match AGENT_API_KEY in secure-worker/.env
AGENT_API_KEY=aegistrips-shared-secret-2024

# URL of the secure-worker TEE service
SECURE_WORKER_URL=http://localhost:3001

# NOTE: No MOCK_CREDIT_CARD or MOCK_PASSPORT here.
# Those credentials live ONLY in secure-worker/.env -- never in the LLM layer.
